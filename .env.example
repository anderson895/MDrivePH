# Optional: pre-fill the key on the setup screen (copy to .env.local).
# Use ONE of these. Either can also be pasted in the app at startup.

# Google Maps Platform key with the "Map Tiles API" enabled
VITE_GOOGLE_MAPS_API_KEY=

# Cesium ion token (free account; add "Google Photorealistic 3D Tiles" from the Asset Depot)
VITE_CESIUM_ION_TOKEN=
